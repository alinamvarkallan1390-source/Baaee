# ── ربات Life Simulator روی روبیکا ──
# این فایل را کپی کن به .env و مقدارها را پر کن.
# اجرا:  python main2.py

# توکن ربات از @BotFather روبیکا
RUBIKA_BOT_TOKEN=

# chat_id ادمین‌ها (با ویرگول جدا کن). همان شناسه‌ی چت خصوصی با ربات است.
# بعد از /start می‌توانی از لاگ ربات یا پنل ادمین آیدی را ببینی.
RUBIKA_ADMIN_IDS=

# مسیر دیتابیس SQLite (روی fly.io معمولاً /data/life_simulator.db)
# LIFE_SIM_DB=life_simulator.db

# پورت HTTP برای health-check و وب‌هوک (پیش‌فرض 8080)
PORT=8080

# اختیاری: آدرس HTTPS عمومی برای وب‌هوک روبیکا
# اگر خالی باشد ربات با getUpdates (polling) کار می‌کند.
# مثال: https://your-app.fly.dev
# RUBIKA_WEBHOOK_URL=
